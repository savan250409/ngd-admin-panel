# Uploaded content is data only — never execute scripts from here.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
<FilesMatch "\.(php|phtml|phar|php\d|pht|cgi|pl|py|sh)$">
    Require all denied
</FilesMatch>
Options -Indexes -ExecCGI

# ── Block direct access to real media (Option A) ───────────────────────────────
# Real "/upload/..." URLs now return 403. Media is served only through the app's
# "/media?token=..." gate, which reads the file from disk in PHP (HTTP rules below
# do NOT affect that). A URL pasted into a browser therefore shows "Forbidden".
# NOTE: only takes effect under Apache with AllowOverride enabled — the local
# `php artisan serve` dev server ignores .htaccess.
# TO REMOVE THIS FEATURE: delete this whole block (and set ADMIN_API_MEDIA_SECURITY=false).
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
